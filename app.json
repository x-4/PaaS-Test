{
  "name": "Inventory Sync Service",
  "description": "Enterprise Inventory Real-time Synchronization Microservice",
  "repository": "",
  "logo": "",
  "keywords": ["inventory", "sync", "microservice", "websocket", "enterprise"],
  "env": {
    "TENANT_ID": {
      "description": "Tenant authentication token (UUID format)",
      "required": true
    },
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production"
    },
    "LOG_LEVEL": {
      "description": "Log level (debug/info/warn/error)",
      "value": "info"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "standard-1x"
    }
  },
  "healthchecks": {
    "path": "/health",
    "timeout": 5
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ]
}
