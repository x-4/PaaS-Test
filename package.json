{
  "name": "inventory-sync-service",
  "version": "1.0.0",
  "description": "Enterprise Inventory Real-time Synchronization Microservice - WebSocket-based data integration node for distributed warehouse inventory management",
  "main": "dist/index.js",
  "imports": {
    "#socket-runtime": {
      "node": [
        "./dist/lib/net/socket-facade.cjs",
        "./src/lib/net/socket-facade.cjs"
      ],
      "default": "./src/lib/net/socket-facade.cjs"
    }
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node src/index.js",
    "build": "node build.js",
    "prestart": "node -e \"if(!require('fs').existsSync('dist/index.js')){console.log('dist/ not found, running build...');require('child_process').execSync('node build.js',{stdio:'inherit'})}\"",
    "test": "node --test"
  },
  "keywords": [
    "inventory",
    "sync",
    "microservice",
    "enterprise",
    "websocket",
    "real-time",
    "erp"
  ],
  "author": "Enterprise Infrastructure Team",
  "license": "Proprietary",
  "dependencies": {},
  "devDependencies": {
    "terser": "^5.51.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}